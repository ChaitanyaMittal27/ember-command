# Tiger Data (TimescaleDB) connection string for the History tab. Server-side only; leave empty to hide the tab.
TIGER_DATABASE_URL=
# The Ask tab: shown only when the flag is exactly "true" (read at build time). The key stays server-side.
NEXT_PUBLIC_ASK_ENABLED=
GEMINI_API_KEY=
# Optional: another Gemini model (default gemini-3.5-flash).
GEMINI_MODEL=
